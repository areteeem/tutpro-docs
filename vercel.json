{
  "framework": "docusaurus-2",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/guides", "destination": "/guides/accounts", "permanent": true },
    { "source": "/accounts", "destination": "/guides/accounts", "permanent": true },
    { "source": "/student/join", "destination": "/guides/student/join", "permanent": true },
    { "source": "/student/workspaces", "destination": "/guides/student/workspaces", "permanent": true },
    { "source": "/schools/migration", "destination": "/guides/teacher/schools", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self'; img-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" }
    ] }
  ]
}
